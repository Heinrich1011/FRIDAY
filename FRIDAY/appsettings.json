{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FridayDb": "Data Source=App_Data/friday.db"
  },
  "Groq": {
    "Model": "openai/gpt-oss-120b",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "TimeoutSeconds": 45,
    "MaxToolRounds": 6,
    "Temperature": 0.15
  },
  "FileMcp": {
    "AllowedDirectories": [
      "App_Data/ApprovedDocs"
    ],
    "AllowedExtensions": [
      ".txt",
      ".md",
      ".csv",
      ".json",
      ".xml",
      ".docx",
      ".log"
    ],
    "MaxFileSizeBytes": 2097152
  },
  "ExternalMcpServers": []
}
